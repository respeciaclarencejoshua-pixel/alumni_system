PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# On Vercel, set CLIENT_ORIGIN to your exact website origin, e.g.
# https://alumni-system-client.vercel.app (comma-separated for additional domains).
# Exact domains from Vercel system environment variables are also allowed.
SUPABASE_QUERY_TIMEOUT_MS=5000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Keep this server-only. Never put it in client/.env files.
SUPABASE_SERVICE_ROLE_KEY=
GIPHY_API_KEY=

# Shared-network ingress protection; signed-in admin limits are also enforced per account.
PUBLIC_API_RATE_LIMIT_PER_MINUTE=3000

# Required for reliable shared limits across Vercel instances. Keep both server-only.
# If neither is set, limits remain per process (suitable for local development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Unique to this application/environment; shared by every instance in that environment.
RATE_LIMIT_KEY_PREFIX=

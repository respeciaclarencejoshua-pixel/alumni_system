{
  "name": "alumni-system",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "start": "npm --workspace server start"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
